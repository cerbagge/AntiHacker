DISCORD_BOT_TOKEN=your_discord_bot_token_here
LOG_LEVEL=info

# ── 코인 스캠 이미지 자동삭제 (antihacker+) ──
# 로컬 스캠 감지 전체 스위치. RAM 업그레이드(32GB) 전엔 false 유지 권장 (기본 꺼짐).
# true 로 바꾸면 OCR/해시 동작, VLM은 Ollama가 떠 있을 때만 추가로 작동.
SCAM_IMAGE_GUARD_ENABLED=false
# 자동삭제 점수 임계값 (기본 70). 이 이상 + 서로 다른 신호 2종류 이상이면 삭제
SCAM_AUTODELETE_THRESHOLD=70
# 로컬 VLM(Ollama) 사용 여부. false면 끔 (기본 켬, Ollama 없으면 자동 스킵)
SCAM_VLM_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_VLM_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT_MS=180000

# ── 첨부 바이러스 검사 (ClamAV, 로컬 clamd 데몬) ──
# 모든 첨부(이미지/파일)를 ClamAV로 검사 → 감염 시 자동삭제. 시그니처 기반이라 가벼움.
# ClamAV 미설치/데몬 정지 시 자동 스킵. (AI 아님 → RAM 업그레이드와 무관하게 동작)
VIRUS_SCAN_ENABLED=true
CLAMAV_BINARY=clamdscan
CLAMAV_TIMEOUT_MS=120000

# ── 서버 잠금(허용목록) ──
# 봇 무단 사용 방지: 루트의 allowedGuilds.json 에 적힌 서버 ID에서만 봇이 작동합니다.
#   - 형식:  ["서버ID1", "서버ID2"]   (빈 배열 [] 이면 잠금 비활성 = 모든 서버 허용)
#   - 비허용 서버에 초대되면 자동 퇴장, 목록에서 ID를 지우면 그 서버에서 즉시 퇴장
#   - 서버 ID 얻기: 디스코드 설정 > 고급 > 개발자 모드 ON → 서버 우클릭 > 서버 ID 복사

# ── 채팅 모더레이터 (실험 기능) ──
# 루트의 experimentalGuilds.json 에 적힌 서버에서만 동작합니다 (형식: ["서버ID1", "서버ID2"]).
#   - 빈 배열 [] 이거나 파일이 없으면 어떤 서버에도 적용하지 않음. 실행 중 수정하면 바로 반영.
#   - 최근 6줄 대화를 로컬 LLM이 판정 → 성적/폭력 위협/혐오: 삭제 + 10분 타임아웃,
#     자살·자해: 삭제 + 도움 안내 DM (타임아웃 안 함). 로그에는 원문 대신 요약만 출력.
#   - 봇 역할에 "메시지 관리" + "멤버 타임아웃" 권한 필요.  설치: ollama pull exaone3.5:7.8b
CHAT_MOD_MODEL=exaone3.5:7.8b
# 관찰 모드: true 면 삭제·타임아웃·DM 없이 판정 로그만 남김 (오탐을 먼저 지켜볼 때)
CHAT_MOD_LOG_ONLY=false
